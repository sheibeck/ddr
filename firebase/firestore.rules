rules_version = '2';

// Phase 79.3 (D-13, BUG-03) + Phase 83 (SRV-01..03, SRV-09). One rules file
// for the whole project — the Action's service account (ddr-bug-reports,
// roles/datastore.user on delve-die-repeat-6ba5f, D-17) and tools/
// boards-admin.mjs (a second service account, moderation) both bypass this
// entire file through IAM, not through a rule, so they can still read, flip
// bugReports.status, delete a run or ban a uid regardless of what clients
// may do here.
//
// A client gets exactly three verbs, each an `allow create`:
//   - bugReports/{reportId}: create a report shaped exactly like
//     src/browser/bugReport.js#buildReportPayload builds it (the report
//     shape below is byte-identical to Phase 79.3 — no uid field is
//     possible), gated on a signed-in uid and a same-commit reportLimits
//     step (SRV-09: a 2-minute cooldown, 5 reports a day).
//   - reportLimits/{uid}: the owner's own cooldown/daily-count document,
//     created or updated only as a valid step; the owner may also read it
//     back (so local storage can be wiped and the count recovered).
//   - runs/{runId}: create the owner's own leaderboard run, shaped and
//     bounded exactly like src/browser/runDoc.js builds it (SRV-02); reads
//     are public and bounded (list limit <= 50); the owner may re-roll their
//     handle across all their runs, and delete any of their own runs.
//     Phase 84 (BOARD-20, BOARD-22) adds `note` (the killer's name, bounded
//     to 120 chars) and `when` (the death time in ms, bounded to no later
//     than request.time plus a one-day clock-skew allowance).
// Every other verb, on every path, is denied by the catch-all at the end.
service cloud.firestore {
  match /databases/{database}/documents {

    // Mirrors src/browser/bugReport.js#RUN_FIELDS, RUN_STRING_MAX_CHARS
    // and RUN_INT_MAX.
    function isValidRun(r) {
      return r is map
        && r.keys().hasOnly(['depth', 'cls', 'sub', 'race', 'level', 'steps', 'day', 'dead'])
        && r.keys().hasAll(['depth', 'cls', 'sub', 'race', 'level', 'steps', 'day', 'dead'])
        && r.depth is int && r.depth >= 0 && r.depth <= 1000000000
        && r.level is int && r.level >= 0 && r.level <= 1000000000
        && r.steps is int && r.steps >= 0 && r.steps <= 1000000000
        && r.day is int && r.day >= 0 && r.day <= 1000000000
        && r.cls is string && r.cls.size() <= 40
        && r.sub is string && r.sub.size() <= 40
        && r.race is string && r.race.size() <= 40
        && r.dead is bool;
    }

    // Mirrors src/browser/bugReport.js#REPORT_FIELDS/REQUIRED_REPORT_FIELDS
    // and every size/type bound (D-11). status must be 'new' and schema
    // must be 1, so a client can never pre-mark a report filed.
    function isValidReport(d) {
      return d.keys().hasOnly(['schema', 'status', 'text', 'oracle', 'oracleLines', 'version', 'platform', 'device', 'clientTime', 'run'])
        && d.keys().hasAll(['schema', 'status', 'text', 'oracle', 'oracleLines', 'version', 'platform', 'device', 'clientTime'])
        && d.schema is int && d.schema == 1
        && d.status is string && d.status == 'new'
        && d.text is string && d.text.size() >= 1 && d.text.size() <= 2000
        && d.oracle is string && d.oracle.size() <= 100000
        && d.oracleLines is int && d.oracleLines >= 0 && d.oracleLines <= 1000
        && d.version is string && d.version.size() >= 1 && d.version.size() <= 64
        && d.platform is string && d.platform.size() >= 1 && d.platform.size() <= 16
        && d.device is string && d.device.size() >= 1 && d.device.size() <= 400
        && d.clientTime is string && d.clientTime.size() >= 1 && d.clientTime.size() <= 40
        && (!('run' in d) || isValidRun(d.run));
    }

    // Phase 83 (SRV-09). Mirrors src/browser/reportLimits.js#REPORT_COOLDOWN_
    // MINUTES/REPORT_DAILY_CAP/LIMIT_FIELDS/validateLimitStep — kept equal by
    // test/unit/firestore-rules.test.js. A report create must land in the
    // same documents:commit as a valid reportLimits/{uid} step (proven by
    // getAfter, below): a fresh player's first report creates the limit
    // document; every later report needs the previous `last` to be at least
    // reportCooldownMinutes() old, and either continues the same UTC day's
    // count (capped at reportDailyCap()) or starts a new day at 1.
    function reportCooldownMinutes() {
      return 2;
    }

    function reportDailyCap() {
      return 5;
    }

    function limitPath(uid) {
      return /databases/$(database)/documents/reportLimits/$(uid);
    }

    function isValidLimitStep(before, after) {
      return after.keys().hasOnly(['last', 'day', 'count'])
        && after.keys().hasAll(['last', 'day', 'count'])
        && after.last is timestamp && after.last == request.time
        && after.day is timestamp
        && after.count is int
        && (before == null
          ? (after.day == request.time.date() && after.count == 1)
          : (before.last + duration.value(reportCooldownMinutes(), 'm') <= request.time
            && (before.day == request.time.date()
              ? (after.day == before.day && after.count == before.count + 1 && after.count <= reportDailyCap())
              : (after.day == request.time.date() && after.count == 1))));
    }

    match /bugReports/{reportId} {
      allow create: if request.auth != null
                    && isValidReport(request.resource.data)
                    && isValidLimitStep(
                         exists(limitPath(request.auth.uid)) ? get(limitPath(request.auth.uid)).data : null,
                         getAfter(limitPath(request.auth.uid)).data
                       );
      allow get, list, update, delete: if false;
    }

    match /reportLimits/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && isValidLimitStep(null, request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && isValidLimitStep(resource.data, request.resource.data);
      allow list, delete: if false;
    }

    // Phase 83 (SRV-02, SRV-03) + Phase 84 (BOARD-20, BOARD-22: note is the
    // killer's name on board rows, when is the death time feeding the
    // expanded row's date line). Mirrors src/browser/runDoc.js#RUN_DOC_FIELDS,
    // every bound constant, and the four rank-key formulas — kept equal by
    // test/unit/firestore-rules.test.js. season is pinned to content/season.js's
    // SEASON; bumping it needs a rules deploy (docs/LEADERBOARDS.md).
    function isValidBoardRun(d) {
      return d.keys().hasOnly(['uid', 'handle', 'season', 'name', 'race', 'sub', 'cls', 'level', 'floor', 'day', 'steps', 'kills', 'gold', 'sp', 'cause', 'note', 'epitaph', 'when', 'hash', 'version', 'seed', 'acts', 'deepKey', 'daysKey', 'killsKey', 'goldKey', 'createdAt'])
        && d.keys().hasAll(['uid', 'handle', 'season', 'name', 'race', 'sub', 'cls', 'level', 'floor', 'day', 'steps', 'kills', 'gold', 'sp', 'cause', 'note', 'epitaph', 'when', 'hash', 'version', 'seed', 'acts', 'deepKey', 'daysKey', 'killsKey', 'goldKey', 'createdAt'])
        && d.uid is string && d.uid.size() >= 1 && d.uid.size() <= 128
        && d.handle is string && d.handle.matches('^@(lantern|moss|soot|gloom|rusty|candle|cellar|crypt|torch|mildew|cobweb|gravel|barrel|dusty|toad|slug|grub|damp|grim|shadow|ember|brine|murky|tomb|ashen|briar|hollow|wretch|musty|grave)(jaw|toe|knee|nose|boot|sock|hood|beard|elbow|spoon|ladle|mop|kettle|mitten|bonnet|knuckle|thumb|chin|shin|wrist|apron|bucket|skillet|tunic|cloak|helmet|buckle|sandal|goblet|pouch)$')
        && d.season is int && d.season == 1
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.race is string && d.race in ['Human', 'Elven', 'Dwarven', 'Wilmsry', 'Fridgian', 'Troll']
        && d.cls is string && d.sub is string && isSubOfClass(d.cls, d.sub)
        && d.level is int && d.level >= 1 && d.level <= 5
        && d.floor is int && d.floor >= 1 && d.floor <= 200
        && d.steps is int && d.steps >= 0 && d.steps <= 999999
        && d.day is int && d.day >= 1 && d.day * 100 <= d.steps + 30000
        && d.kills is int && d.kills >= 0 && d.kills <= d.steps
        && d.gold is int && d.gold >= 0 && d.gold <= 10000000
        && d.sp is int && d.sp >= 0 && d.sp <= 1000000000
        && d.cause is string && d.cause in ['combat', 'starve', 'trap', 'fall', 'gorge', 'backfire', 'summon', 'maze', 'quake', 'potion', 'insanity', 'abandon', 'entombed', 'pilferFumble', 'scrollFumble']
        && d.note is string && d.note.size() <= 120
        && d.epitaph is string && d.epitaph.size() <= 400
        && d.when is int && d.when >= 0 && d.when <= request.time.toMillis() + 86400000
        && d.hash is string && d.hash.matches('^[0-9a-f]{8}$')
        && d.version is string && d.version.size() >= 1 && d.version.size() <= 64
        && d.seed is int && d.seed >= 0 && d.seed <= 9007199254740991
        && d.acts is int && d.acts >= 0 && d.acts <= 1000000000
        && d.deepKey is int && d.deepKey == deepKeyOf(d)
        && d.daysKey is int && d.daysKey == daysKeyOf(d)
        && d.killsKey is int && d.killsKey == killsKeyOf(d)
        && d.goldKey is int && d.goldKey == goldKeyOf(d)
        && d.createdAt == request.time;
    }

    // deepKey: floor desc, then more steps (Phase 87, BOARD-28). daysKey: the Phase 82 DAYS rule
    // — min(day, 10 * floor) desc, then floor desc (the ternary stands in
    // for math.min, which Firestore rules do not have). killsKey: kills
    // desc, then floor desc. goldKey: gold desc.
    function deepKeyOf(d) {
      return d.floor * 1000000 + d.steps;
    }

    function daysKeyOf(d) {
      return (d.day < 10 * d.floor ? d.day : 10 * d.floor) * 1000 + d.floor;
    }

    function killsKeyOf(d) {
      return d.kills * 1000 + d.floor;
    }

    function goldKeyOf(d) {
      return d.gold;
    }

    // Mirrors content/classes.js#CLASSES[cls].subs.
    function isSubOfClass(cls, sub) {
      return (cls == 'Magic User' && sub in ['Wizard', 'Warlock', 'Sorcerer', 'Summoner', 'Cleric', 'Illusionist', 'Court Mage', 'Apprentice'])
        || (cls == 'Fighter' && sub in ['Knight', 'Guard', 'Woodsman', 'Soldier', 'Barbarian', 'Master of Arms', 'Samurai', 'Bard'])
        || (cls == 'Thief' && sub in ['Pickpocket', 'Pilfer', 'Cat Burglar', 'Cutthroat', 'Cloaker', 'Ninja', 'Con Artist', 'Acrobat']);
    }

    match /runs/{runId} {
      allow get: if true;
      // Phase 83 Plan 08 (live-only fix): a runAggregationQuery (count(),
      // used by total()/rankOf()) carries no `limit` at all, so
      // request.query.limit is null for those reads — the original
      // `limit <= 50` clause evaluated that comparison as false and
      // refused every count read live. A plain runQuery (topTen) always
      // sends an explicit limit (<= TOP_N), so this change never widens
      // what a list-with-limit read is allowed to request.
      allow list: if request.query.limit == null || request.query.limit <= 50;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && runId == request.auth.uid + '_' + request.resource.data.hash
                    && isValidBoardRun(request.resource.data)
                    && !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['handle'])
                    && request.resource.data.handle is string
                    && request.resource.data.handle.matches('^@(lantern|moss|soot|gloom|rusty|candle|cellar|crypt|torch|mildew|cobweb|gravel|barrel|dusty|toad|slug|grub|damp|grim|shadow|ember|brine|murky|tomb|ashen|briar|hollow|wretch|musty|grave)(jaw|toe|knee|nose|boot|sock|hood|beard|elbow|spoon|ladle|mop|kettle|mitten|bonnet|knuckle|thumb|chin|shin|wrist|apron|bucket|skillet|tunic|cloak|helmet|buckle|sandal|goblet|pouch)$');
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /banned/{uid} {
      // the admin (IAM service account, tools/boards-admin.mjs) is the only
      // writer of this collection; no rule below grants a client access.
      allow read, write: if false;
    }

    // The catch-all: nothing else in this database is reachable by a
    // client, now or after a later collection is added.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
